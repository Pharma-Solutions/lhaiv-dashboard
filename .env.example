# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Microsoft Graph (SharePoint source) ---
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=your-client-secret-value
# The SharePoint "Copy link" URL for the tracker workbook:
TRACKER_SHARE_URL=https://pharmasolutionsinc.sharepoint.com/:x:/s/allcompany/....

# --- Netlify (publish target) ---
NETLIFY_SITE_ID=your-site-api-id-or-name
NETLIFY_AUTH_TOKEN=your-personal-access-token
